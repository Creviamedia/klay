# Environment Configuration Template for Klay Consultants
# Copy to .env.development, .env.staging, .env.uat, or .env.production as needed.

# Application URL & Host
VITE_SITE_URL=https://klayconsultants.com
VITE_CANONICAL_HOST=klayconsultants.com
VITE_ENVIRONMENT=production

# Lead Submission Endpoint (Native Calculator & Contact Form)
VITE_LEAD_API_ENDPOINT=/api/leads
VITE_ENABLE_MOCK_LEADS=false

# Third-party Integrations (Optional / Fallback)
VITE_FILLOUT_HERO_ID=v3wLQqgVGhus
VITE_FILLOUT_CONTACT_ID=tGKUNBZM4wus
VITE_FILLOUT_SETUP_ID=tGKUNBZM4wus

# Sentry Application Monitoring & Error Tracking
VITE_SENTRY_DSN=https://1b2a1a1524079429a26abdc3a2ad78b4@o4512436228849664.ingest.de.sentry.io/4512436487520336

# Analytics & Tracking (Disabled in Dev & Staging to prevent polluting production data)
VITE_GTM_ID=
VITE_GA_ID=

# Search Engine Indexing (false for Staging/UAT to prevent duplicate content penalties)
VITE_ENABLE_ROBOTS_INDEX=true

# Lead Ingestion Engine & Instant Notifications
# Google Sheets Webhook URL (deployed from Google Apps Script Web App)
GOOGLE_SHEET_WEBHOOK_URL=
# ntfy Push Notification Topic URL (defaults to https://ntfy.sh/klay-leads-dubai)
NTFY_TOPIC_URL=https://ntfy.sh/klay-leads-dubai

# Server Configuration
PORT=3001
CANONICAL_HOST=klayconsultants.com
