{
  "name": "klay-consultants",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n frontend,backend \"vite\" \"node server.js\"",
    "build": "npm run seo:generate && tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/seo.cjs --validate",
    "build:staging": "npm run seo:generate && tsc --noEmit && vite build --mode staging && node scripts/prerender.mjs && node scripts/seo.cjs --validate",
    "build:uat": "npm run seo:generate && tsc --noEmit && vite build --mode uat && node scripts/prerender.mjs && node scripts/seo.cjs --validate",
    "start": "node server.js --production",
    "start:staging": "PORT=3001 node server.js --production",
    "preview": "npm run build && npm start",
    "preview:staging": "npm run build:staging && npm run start:staging",
    "typecheck": "node scripts/validate-env.mjs && tsc --noEmit",
    "validate:env": "node scripts/validate-env.mjs",
    "deploy:hostinger": "npm run build && node scripts/deploy-sftp.mjs",
    "test": "node scripts/test-calculator.mjs",
    "images": "node scripts/optimize-images.mjs",
    "seo:generate": "node scripts/seo.cjs --generate",
    "report:migration": "node scripts/migration-report.cjs",
    "favicons": "node scripts/make-favicons.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@sanity/client": "^8.16.0",
    "@sentry/react": "^11.12.0",
    "@space-ui-components/react": "file:packages/mock-space-ui",
    "@usespaceui/squircle": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "framer-motion": "^14.9.0",
    "lucide-react": "^0.446.0",
    "react": "18.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "20.6.2",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.15",
    "concurrently": "^9.1.2",
    "ffmpeg-static": "^5.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright-core": "^1.65.0",
    "postcss": "8.4.30",
    "prettier": "^3.10.1",
    "sharp": "^0.34.5",
    "ssh2-sftp-client": "^12.1.1",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.2.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
